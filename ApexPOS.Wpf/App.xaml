<Application x:Class="ApexPOS.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ApexPOS.Wpf.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:CurrencyConverter x:Key="Currency"/>
            <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
            <conv:NullToVisibilityConverter x:Key="NullVis"/>
            <conv:LowStockToBrushConverter x:Key="LowStockToBrush"/>
            <conv:PositiveToVisibilityConverter x:Key="PositiveToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
