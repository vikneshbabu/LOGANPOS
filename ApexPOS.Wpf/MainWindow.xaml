<Window x:Class="ApexPOS.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ApexPOS.Wpf.Views"
        xmlns:vm="clr-namespace:ApexPOS.Wpf.ViewModels"
        xmlns:conv="clr-namespace:ApexPOS.Wpf.Converters"
        Title="ApexPOS - Modern Retail Point of Sale" Icon="app.ico" WindowState="Maximized"
        Background="{StaticResource BgDarkBrush}"
        FontFamily="{StaticResource MainFontFamily}" MinWidth="1280" MinHeight="720">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:CurrencyConverter x:Key="Currency"/>

        <!-- View DataTemplate mapping -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <views:RegisterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
            <views:CategoriesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseRateLogbookViewModel}">
            <views:PurchaseRateLogbookView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- LOGIN OVERLAY -->
        <Grid x:Name="LoginOverlay" Panel.ZIndex="100"
              Visibility="{Binding MainVm.IsLoggedIn, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A1A40" Offset="0"/>
                    <GradientStop Color="#11112B" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <!-- Logo Area -->
                <Border Width="68" Height="68" CornerRadius="16" Background="{StaticResource AccentGradientBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" Color="#00A8E8"/>
                    </Border.Effect>
                    <TextBlock Text="LX" FontSize="28" FontWeight="ExtraBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Loganx POS" FontSize="36" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Point of Sale &amp; Retail Management" FontSize="14" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,0,0,36"/>

                <!-- Login Card -->
                <Border Style="{StaticResource CardBorder}" Padding="32">
                    <StackPanel>
                        <!-- Username/Password Login -->
                        <StackPanel x:Name="PasswordLoginPanel"
                                    Visibility="{Binding LoginVm.ShowPinLogin, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                            <TextBlock Text="Sign In" Style="{StaticResource H2}" Margin="0,0,0,24"/>

                            <TextBlock Text="USERNAME" Style="{StaticResource InputLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding LoginVm.Username, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="PASSWORD" Style="{StaticResource InputLabel}"/>
                            <PasswordBox x:Name="PasswordInput" Style="{StaticResource ModernPasswordBox}"
                                         Margin="0,0,0,24"/>

                            <Button Style="{StaticResource PrimaryButton}" Content="🔐  Sign In"
                                    Click="OnPasswordLogin_Click" FontSize="15" Padding="20,12"/>
                        </StackPanel>

                        <!-- PIN Login -->
                        <StackPanel Visibility="{Binding LoginVm.ShowPinLogin, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Quick PIN" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <!-- PIN display -->
                            <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,12" Margin="0,0,0,24"
                                    HorizontalAlignment="Center" MinWidth="180">
                                <TextBlock Text="{Binding LoginVm.PinCode, StringFormat='PIN: {0}'}"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                                           FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Text="{Binding LoginVm.PinCode.Length, StringFormat='{}{0} digits entered'}"
                                       Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <!-- PIN Pad -->
                            <UniformGrid Columns="3" Rows="4" HorizontalAlignment="Center" Width="260">
                                <Button Style="{StaticResource SecondaryButton}" Content="1" Margin="4"
                                        Command="{Binding LoginVm.AppendPinCommand}" CommandParameter="1"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="2" Margin="4"
                                        Command="{Binding LoginVm.AppendPinCommand}" CommandParameter="2"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="3" Margin="4"
                                        Command="{Binding LoginVm.AppendPinCommand}" CommandParameter="3"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="4" Margin="4"
                                        Command="{Binding LoginVm.AppendPinCommand}" CommandParameter="4"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="5" Margin="4"
                                        Command="{Binding LoginVm.AppendPinCommand}" CommandParameter="5"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="6" Margin="4"
                                        Command="{Binding LoginVm.AppendPinCommand}" CommandParameter="6"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="7" Margin="4"
                                        Command="{Binding LoginVm.AppendPinCommand}" CommandParameter="7"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="8" Margin="4"
                                        Command="{Binding LoginVm.AppendPinCommand}" CommandParameter="8"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="9" Margin="4"
                                        Command="{Binding LoginVm.AppendPinCommand}" CommandParameter="9"/>
                                <Button Style="{StaticResource DangerButton}" Content="⌫" Margin="4"
                                        Command="{Binding LoginVm.BackspacePinCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="0" Margin="4"
                                        Command="{Binding LoginVm.AppendPinCommand}" CommandParameter="0"/>
                                <Button Style="{StaticResource SuccessButton}" Content="✓" Margin="4"
                                        Command="{Binding LoginVm.LoginWithPinCommand}"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding LoginVm.ErrorMessage}" Foreground="{StaticResource AccentDangerBrush}"
                                   FontSize="13" Margin="0,16,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding LoginVm.ErrorMessage.Length, Converter={StaticResource BoolVis}}"/>

                        <!-- Toggle Login Mode -->
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding LoginVm.ToggleLoginModeCommand}"
                                Content="{Binding LoginVm.ToggleModeText}"/>
                    </StackPanel>
                </Border>

                <!-- Demo Credentials -->
                <Border Background="#1A1A40" BorderBrush="#252554" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,20,0,0" Opacity="0.95">
                    <StackPanel>
                        <TextBlock Text="Demo Credentials" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                        <TextBlock Text="Admin: admin / admin123  |  PIN: 0000" Foreground="#94A3B8" FontSize="11"/>
                        <TextBlock Text="Cashier: cashier1 / cashier123  |  PIN: 1234" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- MAIN APP SHELL -->
        <Grid Visibility="{Binding MainVm.IsLoggedIn, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation (Corporate Navy #1A1A40) -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="#12122E" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Brand Header: Loganx POS -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentGradientBrush}" Margin="0,0,10,0">
                                <TextBlock Text="LX" FontSize="15" FontWeight="ExtraBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Loganx POS" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Retail POS Edition" Foreground="#94A3B8" FontSize="11" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- User Info at Bottom -->
                    <Border DockPanel.Dock="Bottom" Background="#12122E" Padding="16" Margin="12,0,12,12" CornerRadius="8">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding MainVm.LoggedInUser}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding MainVm.LoggedInRole}" Foreground="#94A3B8" FontSize="11"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="⏻" Style="{StaticResource NavButton}"
                                    Command="{Binding MainVm.LogoutCommand}" ToolTip="Logout"
                                    VerticalAlignment="Center" FontSize="18" Padding="8,4"/>
                        </DockPanel>
                    </Border>

                    <!-- Nav Links -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,0">
                            <TextBlock Text="MAIN MENU" Foreground="#64748B" Margin="16,0,0,12"
                                       FontWeight="SemiBold" FontSize="11"/>

                            <Button Content="📊  Dashboard"
                                    Visibility="{Binding MainVm.CanViewDashboard, Converter={StaticResource BoolVis}}"
                                    Command="{Binding MainVm.NavigateToCommand}" CommandParameter="Dashboard"
                                    Style="{StaticResource NavButton}"/>
                            <Button Content="🛒  Register"
                                    Visibility="{Binding MainVm.CanViewRegister, Converter={StaticResource BoolVis}}"
                                    Command="{Binding MainVm.NavigateToCommand}" CommandParameter="Register"
                                    Style="{StaticResource NavButton}"/>
                            <Button Content="📦  Inventory"
                                    Visibility="{Binding MainVm.CanViewInventory, Converter={StaticResource BoolVis}}"
                                    Command="{Binding MainVm.NavigateToCommand}" CommandParameter="Inventory"
                                    Style="{StaticResource NavButton}"/>
                            <Button Content="🏷️  Categories"
                                    Visibility="{Binding MainVm.CanViewCategories, Converter={StaticResource BoolVis}}"
                                    Command="{Binding MainVm.NavigateToCommand}" CommandParameter="Categories"
                                    Style="{StaticResource NavButton}"/>
                            <Button Content="👥  Customers"
                                    Visibility="{Binding MainVm.CanViewCustomers, Converter={StaticResource BoolVis}}"
                                    Command="{Binding MainVm.NavigateToCommand}" CommandParameter="Customers"
                                    Style="{StaticResource NavButton}"/>
                            <Button Content="🚚  Purchases"
                                    Visibility="{Binding MainVm.CanViewPurchases, Converter={StaticResource BoolVis}}"
                                    Command="{Binding MainVm.NavigateToCommand}" CommandParameter="Purchases"
                                    Style="{StaticResource NavButton}"/>
                            <Button Content="📖  Purchase Logbook"
                                    Visibility="{Binding MainVm.CanViewPurchaseLogbook, Converter={StaticResource BoolVis}}"
                                    Command="{Binding MainVm.NavigateToCommand}" CommandParameter="PurchaseLogbook"
                                    Style="{StaticResource NavButton}"/>
                            <Button Content="🧾  Orders &amp; History"
                                    Visibility="{Binding MainVm.CanViewOrders, Converter={StaticResource BoolVis}}"
                                    Command="{Binding MainVm.NavigateToCommand}" CommandParameter="Orders"
                                    Style="{StaticResource NavButton}"/>
                            <Button Content="⚙️  Settings"
                                    Visibility="{Binding MainVm.CanViewSettings, Converter={StaticResource BoolVis}}"
                                    Command="{Binding MainVm.NavigateToCommand}" CommandParameter="Settings"
                                    Style="{StaticResource NavButton}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1">
                <!-- Header Bar (Clean White with Subtle Border & Controls) -->
                <Border VerticalAlignment="Top" Height="64" Background="{StaticResource BgHeaderBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Panel.ZIndex="10">
                    <DockPanel Margin="24,0">
                        <!-- Left: View Title -->
                        <TextBlock Text="{Binding MainVm.CurrentViewName}" Style="{StaticResource H2}"
                                   VerticalAlignment="Center"/>

                        <!-- Right Controls: Date, Notification Bell, User Avatar -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- Date & Time -->
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionText}"
                                       Text="{Binding MainVm.CurrentDate}" Margin="0,0,20,0"/>

                            <!-- Separator -->
                            <Rectangle Width="1" Height="24" Fill="#E2E8F0" Margin="0,0,16,0"/>

                            <!-- Notification Icon (Bell) with Badge -->
                            <Grid Margin="0,0,16,0" Cursor="Hand" ToolTip="3 New System Alerts">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#F1F5F9"
                                        BorderBrush="#E2E8F0" BorderThickness="1">
                                    <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Notification Badge -->
                                <Border Width="18" Height="18" CornerRadius="9" Background="#EF4444"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                                    <TextBlock Text="3" FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- User Avatar / Account Menu Pill -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="20" Padding="6,4,14,4" Cursor="Hand" ToolTip="Account &amp; Security">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Avatar Circle -->
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentPrimaryBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="SM" FontSize="12" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- User Name & Role -->
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding MainVm.LoggedInUser}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding MainVm.LoggedInRole}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <!-- Active Status Dot -->
                                    <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <!-- Dropdown Arrow -->
                                    <TextBlock Text="▾" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- View Content -->
                <ContentControl Content="{Binding MainVm.CurrentView}" Margin="0,64,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
