<UserControl x:Class="ApexPOS.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ApexPOS.Wpf.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:EqualityToVisibilityConverter x:Key="EqVis"/>
        <conv:CurrencyConverter x:Key="Currency"/>

        <!-- Sub-Nav Button Styles -->
        <Style x:Key="SubNavItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubNavItemActiveStyle" TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Left Sub-Navigation Rail (240px) -->
            <ColumnDefinition Width="250"/>
            <!-- Right Main Settings Panel (*) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SUB-NAVIGATION RAIL ==================== -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,20" Margin="0,0,16,0" VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SETTINGS GROUPS" Style="{StaticResource CaptionText}"
                               FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,12"/>

                    <!-- Group 1: User & Security -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                        <TextBlock Text="🛡️  User &amp; Security" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="6,0,0,14">
                        <!-- Role Permissions (Active State) -->
                        <Button Content="🔑  Role Permissions"
                                Command="{Binding SelectNavItemCommand}" CommandParameter="Role Permissions">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNavItem}" Value="Role Permissions">
                                            <Setter Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="👥  User Accounts"
                                Command="{Binding SelectNavItemCommand}" CommandParameter="User Accounts">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNavItem}" Value="User Accounts">
                                            <Setter Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Group 2: Hardware -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                        <TextBlock Text="🖥️  Hardware" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="6,0,0,14">
                        <Button Content="📟  Register Setup"
                                Command="{Binding SelectNavItemCommand}" CommandParameter="Register Setup">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNavItem}" Value="Register Setup">
                                            <Setter Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🖨️  Printer Config"
                                Command="{Binding SelectNavItemCommand}" CommandParameter="Printer Config">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNavItem}" Value="Printer Config">
                                            <Setter Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="💳  Card Terminal"
                                Command="{Binding SelectNavItemCommand}" CommandParameter="Card Terminal">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNavItem}" Value="Card Terminal">
                                            <Setter Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Group 3: Operations -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                        <TextBlock Text="⚙️  Operations" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="6,0,0,14">
                        <Button Content="📦  Inventory Control"
                                Command="{Binding SelectNavItemCommand}" CommandParameter="Inventory Control">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNavItem}" Value="Inventory Control">
                                            <Setter Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="📜  Transaction Rules"
                                Command="{Binding SelectNavItemCommand}" CommandParameter="Transaction Rules">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNavItem}" Value="Transaction Rules">
                                            <Setter Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🎁  Loyalty Program"
                                Command="{Binding SelectNavItemCommand}" CommandParameter="Loyalty Program">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNavItem}" Value="Loyalty Program">
                                            <Setter Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Group 4: Store Profile -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                        <TextBlock Text="🏪  Store Profile" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="6,0,0,14">
                        <Button Content="🏬  Store &amp; Receipt Rules"
                                Command="{Binding SelectNavItemCommand}" CommandParameter="Store Profile">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNavItem}" Value="Store Profile">
                                            <Setter Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Group 5: Notifications & Reports -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                        <TextBlock Text="📬  Notifications &amp; Reports" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="6,0,0,14">
                        <Button Content="📧  Daily Email Reports"
                                Command="{Binding SelectNavItemCommand}" CommandParameter="Daily Email Reports">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubNavItemStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNavItem}" Value="Daily Email Reports">
                                            <Setter Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== RIGHT MAIN SETTINGS PANEL ==================== -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <!-- Top Bar Controls: System Settings Page Header -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,16" Margin="0,0,0,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️ System Settings" Style="{StaticResource H1}" FontSize="24" Margin="0,0,12,0"/>
                                    <!-- Role Status Badge -->
                                    <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1"
                                            CornerRadius="14" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedRole, StringFormat='Active Target: Role: {0}'}"
                                                   Foreground="#065F46" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="User &amp; Security  ›  Role Permissions Matrix"
                                           Style="{StaticResource CaptionText}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Notification & Account Indicator on the right of header -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                                    <TextBlock Text="🔔 3 Updates" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Background="#E0F2FE" CornerRadius="8" Padding="10,6">
                                    <TextBlock Text="👤 Store Manager (Admin)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Success Toast Alert: ✔ Changes saved. API endpoints updated. -->
                    <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="10"
                            Padding="16,14" Margin="0,0,0,16"
                            Visibility="{Binding ShowToast, Converter={StaticResource BoolVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.1" Color="#10B981"/>
                        </Border.Effect>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕"
                                    Command="{Binding DismissToastCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#065F46" FontSize="14" FontWeight="Bold" Cursor="Hand"
                                    VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✔" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ToastMessage}" Foreground="#065F46"
                                           FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ==================== DAILY EMAIL REPORTS PANEL ==================== -->
                    <Border Style="{StaticResource CardBorder}" Padding="28" Margin="0,0,0,20"
                            Visibility="{Binding ActiveNavItem, Converter={StaticResource EqVis}, ConverterParameter='Daily Email Reports'}">
                        <StackPanel>
                            <!-- Header -->
                            <DockPanel Margin="0,0,0,20">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#E0F2FE" Margin="0,0,14,0" DockPanel.Dock="Left">
                                    <TextBlock Text="📧" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Daily Email Business Summary" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Configure automated daily emails delivering total sales, net profit, and remaining stocks to your inbox."
                                               Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Status Message Banner -->
                            <Border Background="#F0FDF4" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="8"
                                    Padding="14,10" Margin="0,0,0,16"
                                    Visibility="{Binding EmailStatusMessage.Length, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding EmailStatusMessage}" Foreground="#15803D" FontWeight="SemiBold"/>
                            </Border>

                            <!-- Live Preview Cards of What Gets Sent -->
                            <TextBlock Text="TODAY'S REPORT CONTENT PREVIEW" Style="{StaticResource InputLabel}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="4" Margin="0,0,0,24">
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="💰 Today's Sales" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding PreviewTodaySales, Converter={StaticResource Currency}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="📈 Net Profit" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding PreviewTodayProfit, Converter={StaticResource Currency}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentSuccessBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="📦 Stock Units" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding PreviewStockUnits, StringFormat='{}{0} units'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="⚠️ Low Stock Items" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding PreviewLowStockCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentDangerBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Schedule & Recipient Configuration -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="AUTOMATION SCHEDULE &amp; RECIPIENT" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                    <DockPanel Margin="0,0,0,14">
                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="Enable Daily Automated Email" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Send daily sales, profit and stock report automatically" Style="{StaticResource CaptionText}"/>
                                        </StackPanel>
                                        <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding EnableDailyReport, Mode=TwoWay}"/>
                                    </DockPanel>

                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="DISPATCH TIME (24-HOUR FORMAT: HH:mm)" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding DailyReportTime, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="RECIPIENT EMAIL (SEPARATE MULTIPLE WITH COMMA)" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding RecipientEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- SMTP Mail Server Settings -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="SMTP SERVER SETTINGS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                    <UniformGrid Columns="3" Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="SMTP HOST / SERVER" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="4,0,4,0">
                                            <TextBlock Text="SMTP PORT (DEFAULT: 587)" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="SECURITY (TLS / SSL)" Style="{StaticResource InputLabel}"/>
                                            <CheckBox Content="Enable SSL / TLS" IsChecked="{Binding EnableSsl, Mode=TwoWay}" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="SENDER EMAIL ADDRESS" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding SenderEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="SENDER APP PASSWORD / PASSWORD" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding SenderPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SuccessButton}"
                                        Content="✉️ Send Daily Report Now"
                                        Command="{Binding SendTestReportCommand}"
                                        Height="44" Padding="22,0" Margin="10,0,0,0"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                        Content="💾 Save Email Config"
                                        Command="{Binding SaveEmailSettingsCommand}"
                                        Height="44" Padding="22,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ==================== STORE PROFILE PANEL ==================== -->
                    <Border Style="{StaticResource CardBorder}" Padding="28" Margin="0,0,0,20"
                            Visibility="{Binding ActiveNavItem, Converter={StaticResource EqVis}, ConverterParameter='Store Profile'}">
                        <StackPanel>
                            <TextBlock Text="🏬 Store Profile &amp; Receipt Rules" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                            <TextBlock Text="Manage your business identity, currency symbol, and receipt footer." Style="{StaticResource CaptionText}" Margin="0,0,0,20"/>

                            <TextBlock Text="STORE NAME" Style="{StaticResource InputLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <TextBlock Text="STORE ADDRESS" Style="{StaticResource InputLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="STORE PHONE" Style="{StaticResource InputLabel}"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding StorePhone, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="CURRENCY SYMBOL" Style="{StaticResource InputLabel}"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="RECEIPT FOOTER MESSAGE" Style="{StaticResource InputLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Height="60" TextWrapping="Wrap" Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                            <Button Style="{StaticResource SuccessButton}" Content="💾 Save Store Profile"
                                    Command="{Binding SaveSettingsCommand}" Height="42" Padding="24,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== USER ACCOUNTS MANAGEMENT PANEL ==================== -->
                    <Border Style="{StaticResource CardBorder}" Padding="28" Margin="0,0,0,20"
                            Visibility="{Binding ActiveNavItem, Converter={StaticResource EqVis}, ConverterParameter='User Accounts'}">
                        <StackPanel>
                            <!-- Header & Action -->
                            <DockPanel Margin="0,0,0,20">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="👥 User Management &amp; Role Permissions" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Manage staff accounts, credentials, and assign roles (Cashier, Stock Maintainer, Admin, Manager)."
                                               Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                        Content="➕ Add New User"
                                        Command="{Binding OpenCreateUserModalCommand}"
                                        Height="42" Padding="20,0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Role Permissions Info Banner -->
                            <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock Text="ℹ️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Dynamic Sidebar Navigation Permissions:" FontWeight="Bold" FontSize="12" Foreground="#1E40AF"/>
                                        <TextBlock Text="• Cashier: Register, Customers, Orders &amp; History | • Stock Maintainer: Inventory, Categories, Purchases, Dashboard | • Admin/Manager: All 8 Pages"
                                                   FontSize="11" Foreground="#1D4ED8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Users List Table -->
                            <DataGrid ItemsSource="{Binding UsersList}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      Background="Transparent" BorderThickness="0"
                                      RowHeight="48" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTemplateColumn Header="Username" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="👤 " FontSize="12"/>
                                                    <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
