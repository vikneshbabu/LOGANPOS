                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="SPENDING AMOUNT PER 1 POINT (₹)" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" Height="44" FontSize="15" FontWeight="Bold"
                                                     Text="{Binding LoyaltyAmountPerPoint, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Example: ₹250 means ₹250 purchase = 1 loyalty point (₹500 = 2 pts)"
                                                       Style="{StaticResource CaptionText}" FontSize="11" Margin="2,4,0,0"/>
                                        </StackPanel>

                                        <!-- Redeem value per point -->
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Text="POINT REDEEM VALUE (₹)" Style="{StaticResource InputLabel}"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" Height="44" FontSize="15" FontWeight="Bold"
                                                     Text="{Binding LoyaltyPointRedeemValue, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="Value in Rupees per 1 redeemed point (e.g. ₹1.00)"
                                                       Style="{StaticResource CaptionText}" FontSize="11" Margin="2,4,0,0"/>
                                        </StackPanel>
                                    </UniformGrid>

