                                            <TextBlock Text="💡" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Live Configuration Calculation Rule:" FontWeight="Bold" FontSize="13" Foreground="#065F46"/>
                                                <TextBlock Foreground="#047857" FontSize="12" Margin="0,3,0,0">
                                                    <Run Text="Every purchase of "/>
                                                    <Run Text="{Binding LoyaltyAmountPerPoint, Converter={StaticResource Currency}}" FontWeight="Bold"/>
                                                    <Run Text=" earns 1 Loyalty Point. A customer buying ₹1,000 earns points based on Floor(1000 / "/>
                                                    <Run Text="{Binding LoyaltyAmountPerPoint, StringFormat='{}{0:F0}'}"/>
                                                    <Run Text=")."/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
