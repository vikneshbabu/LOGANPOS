                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Receipt Customization" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Digital e-receipt, QR code and email copy layout" Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding ReceiptCustomization2, Mode=TwoWay}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ==================== ACTION BUTTONS BAR ==================== -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,16" Margin="0,0,0,24">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Pending Changes" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Saved changes are applied to active role permissions immediately." Style="{StaticResource CaptionText}"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- Cancel Secondary Button (White/Grey Outline) -->
                                <Button Style="{StaticResource OutlineSecondaryButton}"
                                        Content="✕  Cancel"
                                        Command="{Binding CancelPermissionsCommand}"
                                        Margin="0,0,12,0" Padding="24,12"/>

                                <!-- Save Changes Primary Button (Green) -->
                                <Button Style="{StaticResource SuccessButton}"
                                        Content="💾  Save Changes"
                                        Command="{Binding SavePermissionsCommand}"
                                        Padding="28,12" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Create User Modal Dialog -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="100"
              Visibility="{Binding ShowUserModal, Converter={StaticResource BoolVis}}">
            <Border Background="#1A1A40" Opacity="0.5"/>
            <Border Style="{StaticResource CardBorder}" Width="480" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <TextBlock Text="➕ Create New Staff User" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="Add staff credentials and assign role for POS sidebar permissions."
                               Style="{StaticResource CaptionText}" Margin="0,0,0,20"/>

                    <TextBlock Text="USERNAME *" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                             Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="FULL NAME" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                             Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="USER ROLE / PERMISSION *" Style="{StaticResource InputLabel}"/>
                    <ComboBox ItemsSource="{Binding AvailableRoles}"
                              SelectedItem="{Binding NewUserRole, Mode=TwoWay}"
                              Height="40" Margin="0,0,0,12"/>

                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="PASSWORD" Style="{StaticResource InputLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                                     Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="PIN CODE (4-DIGIT)" Style="{StaticResource InputLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                                     Text="{Binding NewPinCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{Binding UserStatusMessage}" Foreground="{StaticResource AccentDangerBrush}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,16"
                               Visibility="{Binding UserStatusMessage, Converter={StaticResource BoolVis}}"/>

                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,6,0" Height="42"
                                Command="{Binding CloseCreateUserModalCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="💾 Create User" Margin="6,0,0,0" Height="42"
                                Command="{Binding CreateUserCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
