<UserControl x:Class="ApexPOS.Wpf.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ApexPOS.Wpf.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- Main Content Panel -->
        <Border Style="{StaticResource CardBorder}" Padding="24">
            <DockPanel>
                <!-- Header & Search -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SuccessButton}" Content="➕ Add Category"
                            Command="{Binding NewCategoryCommand}" Height="40" Padding="18,0" Margin="12,0,0,0"/>
                    <DockPanel>
                        <!-- Distributor Filter -->
                        <ComboBox DockPanel.Dock="Right" Width="210" Height="40" Margin="10,0,0,0"
                                  ItemsSource="{Binding Suppliers}" SelectedValuePath="Id"
                                  SelectedValue="{Binding FilterSupplierId}" DisplayMemberPath="Name"
                                  ToolTip="Filter by Distributor (All if empty)"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="✕"
                                Command="{Binding ResetFilterCommand}" Height="40" Padding="12,0" Margin="6,0,0,0"
                                ToolTip="Reset Filters"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </DockPanel>

                <!-- Status Banner -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="{StaticResource AccentSuccessBrush}"
                           Margin="0,0,0,12" FontWeight="SemiBold"
                           Visibility="{Binding StatusMessage.Length, Converter={StaticResource BoolVis}}"/>

                <!-- Categories Cards Grid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="270" Background="#FFFFFF" CornerRadius="12"
                                        Padding="18" Margin="0,0,16,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Icon}" FontSize="36" VerticalAlignment="Center"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="✏️" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Edit Category"/>
                                                <Button Content="🗑️" Style="{StaticResource SecondaryButton}" Padding="8,4"
                                                        Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Delete Category"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,2"/>

                                        <!-- Distributor Badge -->
                                        <Border Background="#EFF6FF" CornerRadius="6" Padding="6,2" Margin="0,4,0,6" HorizontalAlignment="Left"
                                                Visibility="{Binding Supplier, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Supplier.Name, StringFormat='🚚 {0}'}"
                                                       Foreground="{StaticResource AccentPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock Text="{Binding SortOrder, StringFormat='Display Order: {0}'}" Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ADD/EDIT MODAL -->
        <Grid Panel.ZIndex="100" Visibility="{Binding ShowEditModal, Converter={StaticResource BoolVis}}">
            <Border Background="#1A1A40" Opacity="0.5"/>
            <Border Style="{StaticResource CardBorder}" Width="440" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="Category Details" Style="{StaticResource H2}" Margin="0,0,0,20"/>

                    <TextBlock Text="CATEGORY NAME" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                    <TextBlock Text="DISTRIBUTOR / SUPPLIER" Style="{StaticResource InputLabel}"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedValuePath="Id"
                              SelectedValue="{Binding EditSupplierId}" DisplayMemberPath="Name"
                              Margin="0,0,0,16"/>

                    <TextBlock Text="CATEGORY ICON / EMOJI" Style="{StaticResource InputLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Height="40" ItemsSource="{Binding AvailableIcons}"
                                  SelectedItem="{Binding SelectedIconItem}"
                                  DisplayMemberPath="DisplayText"/>
                        <Border Grid.Column="1" Width="46" Height="40" Margin="8,0,0,0"
                                Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8"
                                ToolTip="Selected Category Icon Preview">
                            <TextBlock Text="{Binding EditIcon}" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="SORT ORDER" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditSortOrder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24"/>

                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,6,0"
                                Command="{Binding CloseModalCommand}"/>
                        <Button Style="{StaticResource SuccessButton}" Content="💾 Save Category" Margin="6,0,0,0"
                                Command="{Binding SaveCategoryCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
