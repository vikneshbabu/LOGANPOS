<UserControl x:Class="ApexPOS.Wpf.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ApexPOS.Wpf.Converters"
             Background="Transparent">
    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="Currency"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="➕ New Customer"
                    Command="{Binding NewCustomerCommand}" Height="40" Padding="18,0"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="🔍"
                        Command="{Binding SearchCommand}" Height="40" Padding="14,0" Margin="8,0,0,0"/>
                <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </DockPanel>

        <!-- Customer Table -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                      IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/>
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                    <DataGridTextColumn Header="Loyalty Points" Binding="{Binding LoyaltyPoints, StringFormat='{}{0:N0}'}" Width="120"/>
                    <DataGridTextColumn Header="Debt" Binding="{Binding StoreCredit, Converter={StaticResource Currency}}" Width="120"/>
                    <DataGridTemplateColumn Header="Actions" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✏️ Edit" Style="{StaticResource SecondaryButton}" Padding="8,4"
                                        Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Edit Customer Panel -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="50"
              Visibility="{Binding ShowEditPanel, Converter={StaticResource BoolVis}}">
            <Border Background="#1A1A40" Opacity="0.5"/>
            <Border Style="{StaticResource CardBorder}" Width="460" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <TextBlock Text="👤 Customer Details" Style="{StaticResource H2}" Margin="0,0,0,20"/>

                    <TextBlock Text="Customer Code" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditCode}" Margin="0,0,0,12"/>

                    <TextBlock Text="Full Name" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditName}" Margin="0,0,0,12"/>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,6,12">
                            <TextBlock Text="Phone" Style="{StaticResource InputLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditPhone}"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,12">
                            <TextBlock Text="Email" Style="{StaticResource InputLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditEmail}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Debt (₹)" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditDebt, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,6,0"
                                Command="{Binding CancelEditCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="💾 Save Customer" Margin="6,0,0,0"
                                Command="{Binding SaveCustomerCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
